#include <stdio.h>


void initialiserGrilleJoueur(int grille[9][9], int joueur[9][9])
{
    for (int i = 0; i < 9; i++)
    {
        for (int j = 0; j < 9; j++)
        {
            joueur[i][j] = grille[i][j];
        }
    }
}


void afficherGrille(int grille[9][9])
{
    for (int i = 0; i < 9; i++)
    {
        if (i % 3 == 0)
            printf("+-------+-------+-------+\n");

        for (int j = 0; j < 9; j++)
        {
            if (j % 3 == 0)
                printf("| ");

            if (grille[i][j] == 0)
                printf("  ");
            else
                printf("%d ", grille[i][j]);
        }

        printf("|\n");
    }

    printf("+-------+-------+-------+\n");
}


void remplirGrilleJoueur(int joueur[9][9], int grille[9][9])
{
    int ligne, colonne, valeur;

    printf("Ligne (1-9) : ");
    scanf("%d", &ligne);

    printf("Colonne (1-9) : ");
    scanf("%d", &colonne);

    printf("Chiffre (1-9) : ");
    scanf("%d", &valeur);

    if (ligne >= 1 && ligne <= 9 &&
        colonne >= 1 && colonne <= 9 &&
        valeur >= 1 && valeur <= 9)
    {
        if (grille[ligne - 1][colonne - 1] == 0)
        {
            joueur[ligne - 1][colonne - 1] = valeur;
            printf("Chiffre ajoute !\n");
        }
        else
        {
            printf("Case deja remplie !\n");
        }
    }
    else
    {
        printf("Saisie incorrecte !\n");
    }
}

int main()
{
    int grille[9][9] =
    {
        {3, 2, 0, 1, 7, 0, 6, 5, 4},
        {6, 1, 5, 2, 9, 4, 7, 0, 0},
        {0, 7, 8, 3, 0, 6, 2, 9, 1},
        {0, 5, 7, 4, 0, 2, 8, 1, 6},
        {1, 8, 0, 7, 6, 5, 9, 0, 2},
        {2, 3, 6, 0, 1, 0, 5, 4, 0},
        {7, 4, 2, 0, 8, 1, 3, 0, 9},
        {8, 0, 3, 6, 0, 7, 1, 2, 5},
        {5, 6, 0, 9, 2, 3, 4, 0, 8}
    };

    int joueur[9][9];
    int continuer;

    initialiserGrilleJoueur(grille, joueur);

    do
    {
        afficherGrille(joueur);

        remplirGrilleJoueur(joueur, grille);

        printf("\nContinuer ? (1 = oui, 0 = non) : ");
        scanf("%d", &continuer);

    } while (continuer == 1);

    printf("\nFin de la partie !\n");

    return 0;
}
