/* ========================================================================== */
/*  8. NAVIGATION ET PROGRAMME PRINCIPAL                                       */
/* ========================================================================== */

void gererNavigation(void)
{
    /* Grille FACILE (celle de Grille2.0) */
    int facile[TAILLE][TAILLE] =
    {
        {3, 2, 0, 1, 7, 0, 6, 5, 4},
        {6, 1, 5, 2, 9, 4, 7, 0, 0},
        {0, 7, 8, 3, 0, 6, 2, 9, 1},
        {0, 5, 7, 4, 0, 2, 8, 1, 6},
        {1, 8, 0, 7, 6, 5, 9, 0, 2},
        {2, 3, 6, 0, 1, 0, 5, 4, 0},
        {7, 4, 2, 0, 8, 1, 3, 0, 9},
        {8, 0, 3, 6, 0, 7, 1, 2, 5},
        {5, 6, 0, 9, 2, 3, 4, 0, 8}
    };

    /* Grille MOYEN : meme solution, davantage de cases vides */
    int moyen[TAILLE][TAILLE] =
    {
        {0, 0, 0, 1, 7, 0, 6, 5, 4},
        {6, 0, 5, 2, 0, 4, 0, 0, 0},
        {0, 7, 0, 0, 0, 0, 0, 9, 0},
        {9, 0, 0, 4, 0, 0, 0, 0, 6},
        {1, 8, 0, 0, 6, 5, 0, 0, 0},
        {0, 3, 0, 0, 0, 9, 0, 4, 7},
        {0, 4, 2, 0, 8, 1, 3, 0, 0},
        {0, 9, 0, 6, 4, 7, 0, 2, 0},
        {5, 0, 0, 9, 2, 0, 0, 0, 0}
    };

    int choix;
    int niveau;

    do
    {
        choix = afficherMenu();

        switch (choix)
        {
            case 1:
                niveau = afficherSousMenu();
                if (niveau == 1)
                    jouerPartie(facile);
                else if (niveau == 2)
                    jouerPartie(moyen);
                break;

            case 2:
                effacerEcran();
                printf("Chargement de partie... (bientot disponible)\n");
                attendreEntree();
                break;

            case 3:
                afficherRegles();
                break;

            case 4:
                effacerEcran();
                printf("Merci d'avoir joue au Sudoku !\n");
                printf("A bientot !\n");
                break;
        }
    } while (choix != 4);
}

int main(void)
{
    gererNavigation();
