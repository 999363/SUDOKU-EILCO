/* =====================================================
   7. NAVIGATION PRINCIPALE
   ===================================================== */

int gererNavigation(void)
{
    int choix = afficherMenu();

    switch (choix) {

        case 1:
            nouvellePartie();
            break;

        case 2:
            printf("\nChargement de partie...\n");
            printf("Fonctionnalite en cours de developpement.\n");
            break;

        case 3:
            afficherRegles();
            break;

        case 4:
            printf("\nMerci d'avoir joue au Sudoku !\n");
            printf("A bientot !\n");
            return 0;
    }

    return 1;
}


