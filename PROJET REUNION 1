/* =====================================================
   1. CONTROLE DE SAISIE
   ===================================================== */

void vider_buffer(void)
{
    int c;
    do {
        c = getchar();
    } while (c != '\n' && c != EOF);
}

int saisirEntier(char message[])
{
    int valeur;
    int retour;

    do {
        printf("%s", message);
        retour = scanf("%d", &valeur);
        vider_buffer();

        if (retour != 1) {
            printf("Erreur : veuillez entrer un nombre.\n");
        }

    } while (retour != 1);

    return valeur;
}

int verifierchoix(int choix, int max, int min)
{
    while (choix < min || choix > max) {
        printf("Oups, choix non disponible !\n");
        choix = saisirEntier("Recommencez : ");
    }

    return choix;
}


